package funkin.play.cutscene;

/**
 * When a cutscene plays, for V-Slice's video cutscenes.
 */
class CutsceneType
{
	public static var STARTING:String = 'STARTING'; //before the song, the countdown comes after it
	public static var MIDSONG:String = 'MIDSONG';
	public static var ENDING:String = 'ENDING'; //after the song, which ends when it's over
}
